{
  "name": "ttyroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm --filter @ttyroom/e2e run test:e2e",
    "test:browser": "./scripts/test-spring.sh browser",
    "test:visual": "pnpm --filter @ttyroom/web run test:visual",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --check .",
    "depcruise": "depcruise web/src connector/src protocol/src e2e/src test-support/src benchmarks/src legacy/node-server/src"
  },
  "devDependencies": {
    "@ttyroom/connector": "workspace:*",
    "dependency-cruiser": "^17.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
