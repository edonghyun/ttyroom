{
  "name": "@ttyroom/agent",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "ttyroom": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.js",
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ttyroom/protocol": "workspace:*",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
